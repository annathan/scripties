# Copy this file to .env and fill in real values. Never commit .env.

# --- Stage 1: trend scanning ---
# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials)
# Used read-only, to search/list public videos. No OAuth needed for this part.
YOUTUBE_API_KEY=

# --- Stage 2: ideation (LLM) ---
ANTHROPIC_API_KEY=

# --- Stage 3: video generation ---
# Which provider to use: "mock" (no key needed, generates placeholder clips
# locally so you can test the whole pipeline), "runway", or "pika".
VIDEO_PROVIDER=mock
RUNWAY_API_KEY=
# Pika's API is served through fal.ai -- get a key at https://fal.ai (their
# own tooling reads this same FAL_KEY name, so it's kept consistent here).
FAL_KEY=

# --- Narration (text-to-speech) ---
# Which provider to use: "mock" (no key needed, generates a placeholder
# tone) or "elevenlabs".
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=

# --- Stage 5: upload ---
# OAuth client for uploading to YouTube on your channel's behalf.
# Create via Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID -> Desktop app, download JSON, save as youtube_client_secret.json
# (see scripts/setup_youtube_oauth.py). Do not commit that file either.
YOUTUBE_CLIENT_SECRET_FILE=youtube_client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
